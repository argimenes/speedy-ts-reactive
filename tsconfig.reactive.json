{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "node"],
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/feature-api/**/*",
    "src/application/**/*",
    "src/features/**/*",
    "src/index.tsx",
    "src/App.tsx",
    "src/demo/**/*",
    "src/block-tree/**/*",
    "src/history/**/*",
    "src/input/**/*",
    "src/reactive-editor/**/*",
    "src/rendering/**/*",
    "src/runtime/**/*"
  ]
}
